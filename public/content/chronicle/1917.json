    {
      "id": "ch-1917-007",
      "year": 1917,
      "row": 7,
      "sort": "1917-10-26#0007",
      "kind": "event",
      "date": {
        "raw": "26–1 ноября",
        "display_ru": "26–1 ноября 1917 г.",
        "from": "1917-10-26",
        "to": "1917-11-01",
        "precision": "day",
        "style": "single"
      },
      "track": "mil",
      "pol_ru": null,
      "mil_ru": "Выступление ***А. Ф.*** ***Керенского*** – ***П. Н. Краснова***. Поход частей 3-го кавалерийского корпуса под их руководством на Петроград с целью свержения власти [большевиков](#/party/bolsheviks) и восстановления власти ***Временного правительства***. После боя на Пулковских высотах 30 октября и переговоров 1 ноября Гатчина была занята отрядами красноармейцев. Генерал [П. Н. Краснов](#/person/krasnov) сдался в плен, [А. Ф. Керенский](#/person/kerenskiy) бежал.",
      "pol_en": null,
      "mil_en": null,
      "card": "pokhod-kerenskogo-krasnova",
      "refs": {
        "parties": [
          "bolsheviks"
        ],
