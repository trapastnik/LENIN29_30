# Node
# Без слэша: в зонах-worktree node_modules — это СИМЛИНК в ../mtk29/node_modules,
# а паттерн `node_modules/` симлинк не ловит (git видит его как файл, не каталог).
# Из-за этого во всех пяти зонах он висел в `git status` как untracked и мешал
# проверке §12 «видно только своё».
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Build output
dist/
.vite/

# Python venv (for scripts/)
.venv/
__pycache__/
*.pyc

# OS / editor
.DS_Store
.idea/
.vscode/
*.swp
*.swo

# Локальные логи и tmp
/tmp/
*.log

# Claude artefacts (если когда-то оставим .claude в корне проекта)
.claude/settings.local.json

# Секреты / локальные конфиги
.env
.env.local
*.pem
*.key

# Большие бинари, которые не должны попадать в основной репо.
# Венн-фон сам по себе крупный (1.4 МБ) — оставляем, без него диаграмма не работает.
# А вот дубликаты / tmp-скриншоты трейсера — нет.
/tmp/venn-debug/

# Приёмник материалов заказчика. Единственный — ВНЕШНИЙ: ../IN/ рядом с репо.
# Эта строка — защита от того, что кто-то заведёт IN/ внутри worktree
# и утащит в репо полтора гигабайта одним `git add -A`.
IN/

# Архивные сканы от заказчика. Оригиналы живут в ../IN/, в репо едут
# только веб-производные (см. scripts/media/).
*.tif
*.tiff

# Скомпилированный JSX сцены (public/expo/build/) НЕ игнорируется — он
# коммитится по той же логике, что tokens.css и brand-tokens.js (CLAUDE.md §5):
# сборка идёт на сервере и не должна зависеть от прогона генератора.
# Протухание ловится механически — `npm run expo:check` в составе `npm run check`.

# Производные медиа — генерируются `npm run media:build` из ../IN/.
# ~200 МБ, в git не место.
public/content/media/

# Оставляем: содержимое public/content/, public/expo/, public/decor/, public/fonts/
# Это корневые ресурсы проекта, без них не собирается.
