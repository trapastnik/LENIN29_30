{
  "schema": 1,
  "meta": {
    "title": "МТК 29 — дизайн-токены",
    "source": "docs/brand/Lenin-guideline-2026.pdf (палитра RAL) + docs/brand/Fonts-requirements.docx",
    "owner": "зона design",
    "note": [
      "ЕДИНСТВЕННЫЙ источник палитры проекта. Всё остальное генерируется:",
      "  src/styles/tokens.css        — CSS-переменные",
      "  public/expo/brand-tokens.js  — window.MTK_TOKENS и совместимые бандлы",
      "Генератор: node scripts/design/build-tokens.mjs   (--check для проверки)",
      "Новый цвет заводится ЗДЕСЬ, а не константой в компоненте."
    ],
    "valueGrammar": {
      "literal": "#RRGGBB | rgba(...) | 14px | transparent | font-stack — пишется как есть",
      "{ref}": "ссылка на другой токен: в CSS станет var(--ref), в JS — разрешённым значением",
      "mix({a}, {b}, 28%)": "производная от бренд-цвета: 28 % второго цвета подмешано в первый; генератор считает hex, формула остаётся в комментарии"
    }
  },

  "groups": [
    {
      "id": "brand",
      "title": "Бренд-палитра RAL",
      "css": true,
      "comment": "Стр. 5–6 гайдбука. Значения не меняются никогда — это RAL."
    },
    {
      "id": "semantic",
      "title": "Семантические токены",
      "css": true,
      "comment": "Что каким бренд-цветом красим. Меняется здесь, а не в компонентах."
    },
    {
      "id": "camp",
      "title": "Палитра лагерей",
      "css": true,
      "comment": "Выровнено с брендом там, где это возможно."
    },
    {
      "id": "font",
      "title": "Шрифты",
      "css": true,
      "comment": "docs/brand/Fonts-requirements.docx. Курсив на Nolde запрещён — файла начертания нет."
    },
    {
      "id": "metric",
      "title": "Метрики",
      "css": true
    },
    {
      "id": "scroll",
      "title": "Скроллбары",
      "css": true,
      "comment": "На тач-столе скроллбар должен быть виден — иначе не понять, что блок скроллится."
    },
    {
      "id": "layer",
      "title": "Слои карт",
      "css": true,
      "comment": "Совпадают с HSV-парами из map_v6.ipynb."
    },
    {
      "id": "warm",
      "title": "Тёплая палитра design-pass-1 (public/expo/shared.jsx)",
      "css": false,
      "deprecated": true,
      "comment": [
        "ВТОРАЯ ПАЛИТРА. Те же имена, что у бренда, другие значения:",
        "paper #e6d6b5 вместо RAL #F7F9EF, inkSoft #2a1f16 вместо #2a2f33.",
        "Внесена сюда как есть, чтобы шаги 1–2 прошли без визуальных изменений.",
        "Удаляется на шаге 3 вместе со снятием направлений A/B/C зоной ui."
      ]
    },
    {
      "id": "people",
      "title": "Палитра карточки персоналии (public/expo/people-ui.jsx)",
      "css": false,
      "deprecated": true,
      "comment": "Третья копия палитры. Удаляется на шаге 3 по согласованию с зоной ui."
    },
    {
      "id": "side",
      "title": "SIDE_META — цвета лагерей в разделе «Персоналии»",
      "css": false,
      "deprecated": true,
      "comment": [
        "Четвёртый набор цветов лагерей: ни один не совпадает с --camp-*.",
        "«Красные» здесь #b23028, в бренде RAL 3001 #A02128.",
        "Сводится к --camp-* на шаге 3."
      ]
    }
  ],

  "tokens": {
    "ink-black":    { "group": "brand", "value": "#000000", "note": "RAL 9005 «Чёрный янтарь»" },
    "paper-white":  { "group": "brand", "value": "#F7F9EF", "note": "RAL 9010 «Чистый белый» (тёплый)" },
    "paper-pure":   { "group": "brand", "value": "#FFFFFF", "note": "чистый белый для мультимедиа" },
    "brass":        { "group": "brand", "value": "#D2B773", "note": "RAL 1002 «Латунь» — акцент, заголовки" },
    "signal-red":   { "group": "brand", "value": "#A02128", "note": "RAL 3001 «Сигнальный красный»" },
    "slate-blue":   { "group": "brand", "value": "#5D6970", "note": "RAL 7031 «Сине-серый» — 2 этаж" },
    "slate-window": { "group": "brand", "value": "#9DA3A6", "note": "RAL 7040 «Серое окно» — вторичный фон" },
    "iron-grey":    { "group": "brand", "value": "#555D61", "note": "RAL 7011 «Железо-серый» — 3 этаж (наш)" },
    "graphite":     { "group": "brand", "value": "#435059", "note": "«Графитовый» для тёмных мультимедиа-полей" },
    "telegrey-4":   { "group": "brand", "value": "#CFD0CF", "note": "RAL 7047 «Телегрей 4»" },

    "page-bg":      { "group": "semantic", "value": "{iron-grey}",   "note": "фон наших страниц-разделов" },
    "page-bg-deep": { "group": "semantic", "value": "{graphite}",    "note": "тёмные панели, venn-board" },
    "paper":        { "group": "semantic", "value": "{paper-white}", "note": "карточки на светлом" },
    "accent":       { "group": "semantic", "value": "{brass}",       "note": "ведущий акцент" },
    "accent-alt":   { "group": "semantic", "value": "{signal-red}",  "note": "вторичный акцент" },
    "ink":          { "group": "semantic", "value": "{ink-black}",   "note": "текст на светлом" },
    "ink-on-dark":  { "group": "semantic", "value": "{paper-white}", "note": "текст на тёмном" },
    "ink-soft":     { "group": "semantic", "value": "#2a2f33",       "note": "полутон на светлом" },
    "ink-faint":    { "group": "semantic", "value": "#6c737a",       "note": "тонкая мета на светлом" },
    "rule":         { "group": "semantic", "value": "rgba(255,255,255,0.12)", "note": "тонкая линия разделителя" },

    "camp-red":          { "group": "camp", "value": "{signal-red}", "note": "Красные ← сигнальный красный" },
    "camp-red-deep":     { "group": "camp", "value": "#6a0f14" },
    "camp-white":        { "group": "camp", "value": "{telegrey-4}", "note": "Белые ← Телегрей 4" },
    "camp-rev-dem":      { "group": "camp", "value": "#8C4A99", "note": "пурпур (вне бренд-палитры, идентифицирует лагерь)" },
    "camp-green":        { "group": "camp", "value": "#5A8E55", "note": "оливковый" },
    "camp-national":     { "group": "camp", "value": "{brass}", "note": "Национальные ← латунь" },
    "camp-intervention": { "group": "camp", "value": "#2F4A6B", "note": "грозовой синий" },

    "font-display": { "group": "font", "value": "\"Nolde\", \"Playfair Display\", Georgia, serif",             "note": "заголовки, крупные цифры, буквицы. КУРСИВ ЗАПРЕЩЁН" },
    "font-body":    { "group": "font", "value": "\"21 Cent\", \"PT Serif\", Georgia, serif",                   "note": "основной длинный текст, параграфы" },
    "font-accent":  { "group": "font", "value": "\"20 Kopeek\", \"21 Cent\", Georgia, serif",                  "note": "короткие надписи, кнопки, метки с «косой чертой»" },
    "font-mono":    { "group": "font", "value": "\"20 Kopeek\", \"JetBrains Mono\", \"Courier New\", monospace", "note": "акцентные капс-надписи" },
    "font-stamp":   { "group": "font", "value": "\"20 Kopeek\", \"Special Elite\", monospace",                 "note": "штампы, телеграммы. Special Elite в проект не загружается" },

    "touch-hit":  { "group": "metric", "value": "120px",   "note": "минимальная тач-цель" },
    "fs-body":    { "group": "metric", "value": "32px" },
    "brand-skew": { "group": "metric", "value": "-15deg",  "note": "угол наклонных полос — 75° от вертикали" },

    "scroll-thumb":        { "group": "scroll", "value": "{brass}" },
    "scroll-thumb-active": { "group": "scroll", "value": "#b88e3a" },
    "scroll-track":        { "group": "scroll", "value": "rgba(0,0,0,0.45)" },
    "scroll-width":        { "group": "scroll", "value": "14px" },

    "layer-background":   { "group": "layer", "value": "transparent" },
    "layer-borders-dark": { "group": "layer", "value": "#1a1a1a" },
    "layer-arrows-red":   { "group": "layer", "value": "{signal-red}" },
    "layer-arrows-pink":  { "group": "layer", "value": "#cc0066" },
    "layer-front-blue":   { "group": "layer", "value": "#0033cc" },
    "layer-front-green":  { "group": "layer", "value": "#006600" },
    "layer-rivers-cyan":  { "group": "layer", "value": "#5ba8a0" },

    "warm-ink":         { "group": "warm", "value": "{ink-black}" },
    "warm-brass":       { "group": "warm", "value": "{brass}" },
    "warm-red":         { "group": "warm", "value": "{signal-red}" },
    "warm-white":       { "group": "warm", "value": "{telegrey-4}" },
    "warm-ink-soft":    { "group": "warm", "value": "#2a1f16", "note": "тёплая умбра — длинный текст на бумаге" },
    "warm-ink-faint":   { "group": "warm", "value": "#7a6650", "note": "мета на бумаге" },
    "warm-paper-light": { "group": "warm", "value": "#efe4cd" },
    "warm-paper":       { "group": "warm", "value": "#e6d6b5", "note": "КОНФЛИКТ: одноимённый бренд-токен paper = #F7F9EF" },
    "warm-paper-warm":  { "group": "warm", "value": "#d9c398" },
    "warm-paper-dark":  { "group": "warm", "value": "#a8875a" },
    "warm-wood":        { "group": "warm", "value": "#3a2517" },
    "warm-wood-light":  { "group": "warm", "value": "#5a3a22" },
    "warm-red-deep":    { "group": "warm", "value": "#6b0d0d" },
    "warm-ochre":       { "group": "warm", "value": "#c18f3c" },
    "warm-gold":        { "group": "warm", "value": "#d4af3a" },
    "warm-green-map":   { "group": "warm", "value": "#6b7f4a" },
    "warm-blue-map":    { "group": "warm", "value": "#4a6178" },

    "people-ink":       { "group": "people", "value": "{ink-black}" },
    "people-brass":     { "group": "people", "value": "{brass}" },
    "people-red-deep":  { "group": "people", "value": "{signal-red}", "note": "лагерь «Красные»" },
    "people-bg":        { "group": "people", "value": "#120803", "note": "тёмное сукно стола" },
    "people-bg-deep":   { "group": "people", "value": "#0a0502" },
    "people-paper":     { "group": "people", "value": "#e8d4a8", "note": "КОНФЛИКТ: третье значение для имени paper" },
