    "side-green-color":  { "group": "side", "value": "#4d5a28", "note": "≠ --camp-green #5A8E55" },
    "side-green-accent": { "group": "side", "value": "#6a7a3a" },
    "side-green-flag":   { "group": "side", "value": "#3a4418" }
  },

  "bundles": {
    "MTK_TOKENS": {
      "kind": "auto",
      "comment": "Плоская карта всех токенов с разрешёнными значениями: MTK_TOKENS['brass'] === '#D2B773'. Рядом MTK_GROUPS и MTK_TOKEN_META — для brand.html, чтобы каталог рисовал свотчи циклом, а не описывал их руками."
    },

    "BRAND_THEME": {
      "kind": "map",
      "comment": "Совместимость: ровно то, что раньше собирал public/expo/theme.js.",
      "map": {
        "inkBlack": "{ink-black}",
        "paperWhite": "{paper-white}",
        "paperPure": "{paper-pure}",
        "brass": "{brass}",
        "signalRed": "{signal-red}",
        "slateBlue": "{slate-blue}",
        "slateWindow": "{slate-window}",
        "ironGrey": "{iron-grey}",
        "graphite": "{graphite}",
        "telegrey4": "{telegrey-4}",
        "ink": "{ink}",
        "paper": "{paper}",
        "accent": "{accent}",
        "accentAlt": "{accent-alt}",
        "pageBg": "{page-bg}",
        "pageBgDeep": "{page-bg-deep}",
        "inkOnDark": "{ink-on-dark}",
        "rule": "{rule}",
        "camp": {
          "red": "{camp-red}",
          "redDeep": "{camp-red-deep}",
          "white": "{camp-white}",
          "revDem": "{camp-rev-dem}",
          "green": "{camp-green}",
          "national": "{camp-national}",
          "intervention": "{camp-intervention}"
        }
      }
    },

    "BRAND_FONTS": {
      "kind": "map",
      "comment": "Совместимость с theme.js.",
      "map": {
        "display": "{font-display}",
        "body": "{font-body}",
        "accent": "{font-accent}",
        "mono": "{font-mono}",
        "stamp": "{font-stamp}"
      }
    },

    "MTK_THEME": {
      "kind": "map",
      "deprecated": true,
      "comment": "Тёплый слой для public/expo/shared.jsx. Ключи 1:1 с прежним локальным `theme`, поэтому direction-*.jsx не меняются. Удаляется на шаге 3.",
      "map": {
        "ink": "{warm-ink}",
        "brass": "{warm-brass}",
        "red": "{warm-red}",
        "white": "{warm-white}",
        "inkSoft": "{warm-ink-soft}",
        "inkFaint": "{warm-ink-faint}",
        "paperLight": "{warm-paper-light}",
        "paper": "{warm-paper}",
        "paperWarm": "{warm-paper-warm}",
        "paperDark": "{warm-paper-dark}",
        "wood": "{warm-wood}",
        "woodLight": "{warm-wood-light}",
        "redDeep": "{warm-red-deep}",
        "ochre": "{warm-ochre}",
        "gold": "{warm-gold}",
        "greenMap": "{warm-green-map}",
        "blueMap": "{warm-blue-map}"
      }
    },

    "MTK_FONTS": {
      "kind": "map",
      "comment": "Набор шрифтов в форме, которую ожидает shared.jsx (есть алиас rus).",
      "map": {
        "display": "{font-display}",
        "body": "{font-body}",
        "mono": "{font-mono}",
        "stamp": "{font-stamp}",
        "rus": "{font-body}"
      }
    },

    "MTK_PEOPLE_THEME": {
      "kind": "map",
      "deprecated": true,
      "comment": "Палитра карточки персоналии. Ключи 1:1 с прежним локальным `theme` в people-ui.jsx.",
      "map": {
        "ink": "{people-ink}",
        "brass": "{people-brass}",
        "redDeep": "{people-red-deep}",
        "bg": "{people-bg}",
        "bgDeep": "{people-bg-deep}",
        "paper": "{people-paper}",
