    "MTK_SIDE_META": {
      "kind": "map",
      "deprecated": true,
      "comment": "SIDE_META из people-ui.jsx. Цвета вне бренд-палитры; на шаге 3 сводятся к --camp-*.",
      "map": {
        "red":   { "ru": "Красные",     "en": "Reds",        "color": "{side-red-color}",   "accent": "{side-red-accent}",   "flag": "{side-red-flag}" },
        "white": { "ru": "Белые",       "en": "Whites",      "color": "{side-white-color}", "accent": "{side-white-accent}", "flag": "{side-white-flag}" },
